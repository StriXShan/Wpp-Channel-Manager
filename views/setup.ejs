<%- include('partials/head', { title: 'Primer uso' }) %>
<div class="auth-logo"><img src="/static/logo.svg" alt="" width="56" height="56"><div><strong>WCM</strong><span class="muted">Wpp Channel Manager</span></div></div>
<div class="card">
  <h1>Bienvenido</h1>
  <p class="muted">Creá el usuario administrador. Después vas a poder sumar al resto del equipo.</p>
  <% if (error) { %><div class="notice error"><%= error %></div><% } %>
  <form method="post" action="/setup" class="stack">
    <label>Código de instalación
      <input name="setup_token" required autocomplete="off" autofocus>
      <span class="muted small">Aparece en los registros del servidor al arrancar (por ejemplo, <code>docker compose logs</code>).</span>
    </label>
    <label>Usuario <input name="username" autocomplete="username" required></label>
    <label>Contraseña (mínimo 8 caracteres) <input name="password" type="password" minlength="8" autocomplete="new-password" required></label>
    <button class="primary">Crear administrador</button>
  </form>
</div>
<%- include('partials/foot') %>
