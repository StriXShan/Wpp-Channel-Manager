<%- include('partials/head', { title: 'Mi cuenta' }) %>
<div class="page-head"><h1>Mi cuenta</h1></div>
<% if (error) { %><div class="notice error"><%= error %></div><% } %>

<section class="card">
  <h2>Verificación en dos pasos</h2>
  <% if (has2fa) { %>
    <p><span class="badge state-open">Activada</span> Para entrar se pide la contraseña y un código de tu celular.</p>
    <form method="post" action="/account/2fa/disable" class="row">
      <input name="code" inputmode="numeric" autocomplete="one-time-code" placeholder="Código actual para desactivarla" required>
      <button>Desactivar</button>
    </form>
  <% } else { %>
    <p class="muted">Aunque alguien consiga tu contraseña, no va a poder entrar sin el código de tu celular. Muy recomendado para administradores.</p>
    <div class="link-card">
      <img class="totp-qr" src="<%= setup.qr %>" alt="Código QR para la app de verificación">
      <div class="stack">
        <ol>
          <li>Instalá una app de verificación (Google Authenticator, Authy, 1Password).</li>
          <li>Escaneá este código con la app. Si no podés, cargá a mano la clave: <code><%= setup.secret %></code></li>
          <li>Escribí el código de 6 números que muestra la app.</li>
        </ol>
        <form method="post" action="/account/2fa/enable" class="row">
          <input type="hidden" name="secret" value="<%= setup.secret %>">
          <input name="code" inputmode="numeric" autocomplete="one-time-code" placeholder="Código de 6 números" required>
          <button class="primary">Activar</button>
        </form>
      </div>
    </div>
  <% } %>
</section>

<section class="card">
  <h2>Cambiar contraseña</h2>
  <form method="post" action="/account/password" class="grid-form">
    <label>Contraseña actual <input name="current_password" type="password" autocomplete="current-password" required></label>
    <label>Nueva contraseña <input name="new_password" type="password" minlength="8" autocomplete="new-password" required></label>
    <button>Guardar</button>
  </form>
</section>
<%- include('partials/foot') %>
