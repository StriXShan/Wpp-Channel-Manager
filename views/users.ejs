<%- include('partials/head', { title: 'Usuarios' }) %>
<div class="page-head"><h1>Usuarios</h1></div>

<% const groups = [
  { role: 'admin', title: 'Administradores', desc: 'Ven las publicaciones de todos y manejan números, canales y usuarios.', add: 'Agregar administrador', empty: '' },
  { role: 'editor', title: 'Equipo de contenidos', desc: 'Cargan y programan sus publicaciones. Solo ven lo suyo.', add: 'Agregar a contenidos', empty: 'Todavía no hay nadie en contenidos.' },
]; %>

<% groups.forEach(g => { const list = users.filter(u => u.role === g.role); %>
<section class="card">
  <div class="page-head">
    <div>
      <h2><%= g.title %> <span class="muted">(<%= list.length %>)</span></h2>
      <p class="muted small"><%= g.desc %></p>
    </div>
  </div>

  <% if (!list.length) { %><p class="muted"><%= g.empty %></p><% } else { %>
  <table class="table">
    <thead><tr><th>Usuario</th><th>Dos pasos</th><th>Programadas</th><th></th></tr></thead>
    <tbody>
    <% list.forEach(u => { %>
      <tr>
        <td><%= u.username %><% if (u.id === user.id) { %> <span class="muted">(vos)</span><% } %></td>
        <td><%= u.has2fa ? 'Activada' : 'No' %></td>
        <td><a href="/posts?author=<%= u.id %>"><%= u.pending %></a></td>
        <td class="actions">
          <details>
            <summary>Cambiar contraseña</summary>
            <form method="post" action="/users/<%= u.id %>/password" class="row">
              <input name="password" type="password" minlength="8" required placeholder="Nueva contraseña" autocomplete="new-password">
              <button>Guardar</button>
            </form>
          </details>
          <% if (u.has2fa && u.id !== user.id) { %>
            <form method="post" action="/users/<%= u.id %>/reset-2fa" onsubmit="return confirm('¿Quitar la verificación en dos pasos? Usalo si la persona perdió el celular.')"><button class="link">Quitar dos pasos</button></form>
          <% } %>
          <% if (u.id !== user.id) { %>
            <form method="post" action="/users/<%= u.id %>/role" onsubmit="return confirm('¿Cambiar el rol de este usuario?')">
              <input type="hidden" name="role" value="<%= u.role === 'admin' ? 'editor' : 'admin' %>">
              <button class="link"><%= u.role === 'admin' ? 'Pasar a contenidos' : 'Hacer administrador' %></button>
            </form>
            <form method="post" action="/users/<%= u.id %>/delete" onsubmit="return confirm('¿Borrar este usuario?')"><button class="link danger">Borrar</button></form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% } %>

  <details class="add-user">
    <summary><%= g.add %></summary>
    <form method="post" action="/users" class="grid-form">
      <input type="hidden" name="role" value="<%= g.role %>">
      <label>Usuario <input name="username" required autocomplete="off"></label>
      <label>Contraseña <input name="password" type="password" minlength="8" required autocomplete="new-password"></label>
      <button class="primary">Crear</button>
    </form>
  </details>
</section>
<% }) %>
<%- include('partials/foot') %>
